<style>
:root{--pink:#ff2d55;--accent:#7a1f3d;--accent2:#5c1530;--gold:#b98b5e;--ink:#2b1a14;--mute:#8a6f62;--latte:#c9a68a;--cream:#f7efe8;--glass:rgba(255,248,242,.6);--line:rgba(255,255,255,.75);--shadow:0 14px 44px rgba(60,28,20,.14)}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Inter","Segoe UI",sans-serif;color:var(--ink);min-height:100vh;-webkit-font-smoothing:antialiased;position:relative;
background:radial-gradient(1000px 700px at 6% -12%,rgba(122,31,61,.34) 0,transparent 60%),radial-gradient(900px 650px at 104% 4%,rgba(139,94,60,.36) 0,transparent 58%),radial-gradient(800px 600px at 50% 115%,rgba(201,166,138,.55) 0,transparent 60%),#ecdccf;background-attachment:fixed}
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.06;mix-blend-mode:multiply;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
#auth-screen,#main-app{position:relative;z-index:1}
.blob{position:fixed;border-radius:50%;filter:blur(70px);pointer-events:none;z-index:0}
.blob.b1{width:340px;height:340px;left:-80px;top:38%;background:rgba(122,31,61,.22)}
.blob.b2{width:300px;height:300px;right:-60px;bottom:6%;background:rgba(185,139,94,.3)}
.hidden{display:none!important}
h1,h2{font-family:"Fraunces",Georgia,"Times New Roman",serif}
h2{letter-spacing:-.01em;color:var(--accent2)}
.glass{background:var(--glass);backdrop-filter:blur(28px) saturate(175%);-webkit-backdrop-filter:blur(28px) saturate(175%);border:1px solid var(--line);border-radius:30px;box-shadow:var(--shadow),inset 0 1px 0 rgba(255,255,255,.7),inset 0 -1px 0 rgba(122,31,61,.05)}
.logo{font-family:"Fraunces",Georgia,serif;font-weight:700;letter-spacing:-.03em;color:#3b2218}.logo b{color:#8f1d3f;font-weight:800}
input,select,textarea{width:100%;padding:12px 15px;border-radius:16px;border:1px solid rgba(90,58,46,.14);background:rgba(255,252,249,.82);font:inherit;color:var(--ink);outline:none;transition:border-color .15s,box-shadow .15s}
input::placeholder{color:#b49a8c}
input:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 4px rgba(122,31,61,.14)}
label{font-size:12px;font-weight:500;color:var(--mute);display:block;margin:0 0 5px 4px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:11px 18px;border-radius:16px;border:0;font:inherit;font-weight:600;cursor:pointer;background:linear-gradient(160deg,#8f2548,var(--accent2));color:#fff7f3;box-shadow:0 8px 20px rgba(92,21,48,.3),inset 0 1px 0 rgba(255,255,255,.22);transition:transform .15s,box-shadow .15s}
.btn:hover{transform:translateY(-1px);box-shadow:0 12px 26px rgba(92,21,48,.36),inset 0 1px 0 rgba(255,255,255,.22)}.btn:active{transform:scale(.98)}
.btn.soft{background:rgba(255,250,246,.88);color:var(--accent2);border:1px solid rgba(90,58,46,.14);box-shadow:none}
.btn.soft:hover{background:#fff;box-shadow:0 4px 14px rgba(60,28,20,.1)}
.btn.sm{padding:7px 11px;font-size:12px;border-radius:11px}
.btn svg,.tab svg{width:16px;height:16px}
.btn:focus-visible,.tab:focus-visible,.chip:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.tabs{background:rgba(90,58,46,.09);box-shadow:inset 0 1px 3px rgba(60,28,20,.08)}
.tab{padding:9px 18px;border-radius:999px;border:0;background:transparent;font:inherit;font-weight:600;color:var(--mute);cursor:pointer;display:flex;gap:7px;align-items:center;transition:background .15s,color .15s}
.tab.on{background:#fffaf6;color:var(--accent);box-shadow:0 2px 12px rgba(60,28,20,.14)}
header .glass{border-radius:24px}
/* karşılama bandı */
.hero{display:grid;grid-template-columns:1.4fr 1fr;gap:20px;align-items:center;padding:28px 30px;border-radius:32px;color:#fff3ec;position:relative;overflow:hidden;
background:radial-gradient(500px 260px at 90% 0,rgba(201,166,138,.45),transparent 65%),linear-gradient(135deg,#6a1a38 0,#4a1d2c 55%,#3b2218 100%);box-shadow:0 18px 50px rgba(74,29,44,.35),inset 0 1px 0 rgba(255,255,255,.18)}
.hero::after{content:"";position:absolute;right:-70px;top:-70px;width:240px;height:240px;border-radius:50%;border:1px solid rgba(255,255,255,.14);box-shadow:0 0 0 38px rgba(255,255,255,.03),0 0 0 80px rgba(255,255,255,.02)}
.hero h2{color:#fff;font-size:2rem;line-height:1.15;margin:0 0 8px;font-weight:600}
.hero p{margin:0 0 16px;max-width:46ch;line-height:1.55;color:rgba(255,236,226,.82)}
.hero .btn.soft{background:rgba(255,248,242,.95)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;position:relative;z-index:1}
.stat{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:20px;padding:14px 8px;text-align:center;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.stat b{display:block;font-family:"Fraunces",Georgia,serif;font-size:1.9rem;line-height:1;font-weight:600}
.stat span{font-size:12px;color:rgba(255,236,226,.78)}
/* kartlar */
.grid-items{display:grid;grid-template-columns:repeat(auto-fill,minmax(176px,1fr));gap:18px}
.card{padding:10px;border-radius:24px;background:rgba(255,251,247,.82);border:1px solid var(--line);box-shadow:0 6px 20px rgba(60,28,20,.08);display:flex;flex-direction:column;gap:7px;transition:transform .2s,box-shadow .2s}
.card:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(60,28,20,.16)}
.ph{aspect-ratio:1/1;border-radius:18px;background:linear-gradient(145deg,#f3e2d3,#e9c9c9 55%,#d9b6a3);display:flex;align-items:center;justify-content:center;font-size:40px;overflow:hidden;box-shadow:inset 0 0 0 1px rgba(255,255,255,.5)}
.ph[data-c=sal]{background:linear-gradient(145deg,#f7e1e5,#e3b3c0)}
.ph[data-c=ust]{background:linear-gradient(145deg,#f6e6d6,#e2c3a4)}
.ph[data-c=alt]{background:linear-gradient(145deg,#e8d6c8,#c4a18a)}
.ph[data-c=ayakkabi]{background:linear-gradient(145deg,#efd9d0,#cf9f93)}
.ph img{width:100%;height:100%;object-fit:cover}
.tag{font-size:11px;padding:3px 10px;border-radius:999px;background:rgba(122,31,61,.1);color:var(--accent);font-weight:600}
.tag.coffee{background:rgba(139,94,60,.15);color:#6b4a38}
.chip{flex:0 0 auto;width:82px;padding:4px;border-radius:16px;border:2px solid transparent;background:rgba(255,251,247,.78);cursor:pointer;font:inherit;font-size:11px;color:var(--ink);text-align:center;transition:border-color .15s,transform .15s}
.chip:hover{transform:translateY(-2px)}
.chip.on{border-color:var(--accent);box-shadow:0 6px 16px rgba(122,31,61,.24)}.chip .ph{font-size:24px;border-radius:12px}
.strip{display:flex;gap:9px;overflow-x:auto;padding:5px 3px 9px;scrollbar-width:thin;scrollbar-color:var(--latte) transparent}
.slot{display:flex;gap:12px;align-items:center;padding:10px;border-radius:22px;background:rgba(255,251,247,.65);border:1px dashed rgba(122,31,61,.28);transition:background .15s}
.slot:hover{background:rgba(255,251,247,.9)}
.slot .ph{width:76px;height:76px;aspect-ratio:auto;font-size:28px;flex:0 0 auto}
.bub{padding:11px 15px;border-radius:20px;max-width:92%;white-space:pre-wrap;line-height:1.55;font-size:14px}
.bub.ai{background:#fffaf6;border:1px solid rgba(90,58,46,.1);border-bottom-left-radius:6px}
.bub.me{background:linear-gradient(160deg,#8f2548,var(--accent2));color:#fff7f3;margin-left:auto;border-bottom-right-radius:6px}
.done{text-decoration:line-through;color:var(--mute)}
.wish-i{display:flex;align-items:center;gap:12px;padding:13px 15px;border-radius:20px;background:rgba(255,251,247,.82);border:1px solid var(--line);box-shadow:0 3px 12px rgba(60,28,20,.06)}
/* giriş ekranı */
.auth-wrap{display:grid;grid-template-columns:1fr 1fr;overflow:hidden;padding:0}
.auth-art{padding:44px 38px;color:#fff3ec;position:relative;display:flex;flex-direction:column;justify-content:flex-end;gap:14px;min-height:480px;
background:radial-gradient(420px 300px at 100% 0,rgba(201,166,138,.5),transparent 65%),linear-gradient(150deg,#6a1a38,#3b2218)}
.auth-art::before{content:"";position:absolute;left:-60px;top:-60px;width:220px;height:220px;border-radius:50%;border:1px solid rgba(255,255,255,.16);box-shadow:0 0 0 40px rgba(255,255,255,.04)}
.auth-art h2{color:#fff;font-size:2rem;line-height:1.15;margin:0;font-weight:600;position:relative}
.auth-art h2 i{font-style:italic;color:#f1cfa8}
.auth-art ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;position:relative;color:rgba(255,236,226,.85);font-size:14px}
.auth-art li::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:#f1cfa8;margin-right:10px;vertical-align:middle}
.auth-form-side{padding:40px 38px;display:flex;flex-direction:column;justify-content:center}
::-webkit-scrollbar{height:8px;width:8px}::-webkit-scrollbar-thumb{background:var(--latte);border-radius:8px}
@media (max-width:820px){.hero{grid-template-columns:1fr;padding:22px}.hero h2{font-size:1.6rem}}
@media (max-width:760px){.auth-wrap{grid-template-columns:1fr;max-width:28rem}.auth-art{display:none}.auth-form-side{padding:30px 24px}}
@media (max-width:640px){.tab{padding:8px 12px}.tab span{display:none}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<div class="blob b1" aria-hidden="true"></div><div class="blob b2" aria-hidden="true"></div>

<!-- ===================== GİRİŞ EKRANI ===================== -->
<section id="auth-screen" class="hidden min-h-screen flex items-center justify-center p-5">
  <div class="glass auth-wrap w-full max-w-4xl">
    <aside class="auth-art" aria-hidden="true">
      <h2>Dolabın dağınık değil, <i>henüz planlanmadı.</i></h2>
      <ul><li>Şal, üst, alt ve ayakkabıyı katman katman dene</li><li>Kumaş dokularına göre yapay zeka tavsiyesi al</li><li>Pinterest'te ilham bul, eksikleri listene yaz</li></ul>
    </aside>
    <div class="auth-form-side">
    <h1 class="logo text-5xl text-center m-0"><b>G</b>RWM</h1>
    <p class="text-center m-0 mt-1 mb-6" style="color:var(--mute)">Dijital gardırobuna hoş geldin</p>
    <div class="tabs flex gap-1 p-1 rounded-full mb-5">
      <button class="tab on flex-1 justify-center" id="mode-login" type="button">Giriş Yap</button>
      <button class="tab flex-1 justify-center" id="mode-register" type="button">Kayıt Ol</button>
    </div>
    <form id="auth-form" class="flex flex-col gap-3" novalidate>
      <div><label for="email">E-posta</label><input id="email" type="email" autocomplete="email" placeholder="ornek@mail.com"></div>
      <div><label for="password">Şifre</label><input id="password" type="password" autocomplete="current-password" placeholder="En az 6 karakter"></div>
      <p id="auth-msg" class="m-0 text-sm hidden" style="color:var(--accent)" role="alert"></p>
      <button class="btn" id="auth-submit" type="submit">Giriş Yap</button>
    </form>
    <p id="auth-note" class="text-xs text-center mt-4 mb-0" style="color:var(--mute)"></p>
    </div>
  </div>
</section>

<!-- ===================== ANA UYGULAMA ===================== -->
<div id="main-app" class="hidden">
  <header class="sticky top-0 z-20 px-4 pt-3">
    <div class="glass max-w-6xl mx-auto px-5 py-3 flex items-center justify-between gap-3 flex-wrap" style="border-radius:20px">
      <h1 class="logo text-3xl m-0"><b>G</b>RWM</h1>
      <nav class="tabs flex gap-1 p-1 rounded-full" aria-label="Ana menü">
        <button class="tab on" data-tab="closet" type="button"><i data-lucide="shirt"></i><span>Dolabım</span></button>
        <button class="tab" data-tab="studio" type="button"><i data-lucide="sparkles"></i><span>Kombin Yap</span></button>
        <button class="tab" data-tab="wish" type="button"><i data-lucide="shopping-bag"></i><span>Alınacaklar</span></button>
      </nav>
      <div class="flex items-center gap-2"><span id="sync-label" class="text-xs hidden sm:inline" style="color:var(--mute)"></span><span id="user-label" class="text-sm hidden sm:inline" style="color:var(--mute)"></span>
        <button class="btn soft sm" id="logout" type="button"><i data-lucide="log-out"></i>Çıkış</button></div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto p-4 pb-16">

    <!-- DOLABIM -->
    <section id="tab-closet">
      <div class="hero mb-4">
        <div style="position:relative;z-index:1">
          <h2>Bugün ne giyiyorsun?</h2>
          <p>Parçalarını ekle, katman katman kombinle, kumaş ve renk uyumu için Gemini'den fikir al.</p>
          <button class="btn soft" id="hero-cta" type="button"><i data-lucide="sparkles"></i>Kombin Yap</button>
        </div>
        <div class="stats"><div class="stat"><b id="st-items">0</b><span>Parça</span></div><div class="stat"><b id="st-outfits">0</b><span>Kombin</span></div><div class="stat"><b id="st-wish">0</b><span>Alınacak</span></div></div>
      </div>
      <div class="grid gap-4 lg:grid-cols-[340px_1fr]">
        <form id="item-form" class="glass p-5 flex flex-col gap-3 h-fit" novalidate>
          <h2 class="m-0 text-lg font-bold">Yeni parça ekle</h2>
          <div><label for="i-name">Parça adı</label><input id="i-name" placeholder="Örn: Bordo şal"></div>
          <div><label for="i-cat">Kategori</label>
            <select id="i-cat"><option value="sal">Şal / Eşarp</option><option value="ust">Üst</option><option value="alt">Alt</option><option value="ayakkabi">Ayakkabı</option></select></div>
          <div><label for="i-color">Renk</label><input id="i-color" placeholder="Örn: bordo"></div>
          <div><label for="i-fabric">Kumaş türü</label>
            <select id="i-fabric"><option>Pamuk</option><option>Keten</option><option>İpek</option><option>Kot</option><option>Şifon</option><option>Yün</option><option>Triko</option><option>Saten</option><option>Deri</option><option>Kadife</option><option>Diğer</option></select></div>
          <div><label for="i-url">Görsel URL (isteğe bağlı)</label><input id="i-url" placeholder="https://..."></div>
          <div><label for="i-file">veya bilgisayardan yükle</label><input id="i-file" type="file" accept="image/*"></div>
          <p id="item-msg" class="m-0 text-sm hidden" style="color:var(--accent)" role="alert"></p>
          <button class="btn" type="submit"><i data-lucide="plus"></i>Dolaba ekle</button>
        </form>
        <div class="glass p-5">
          <div class="flex items-center justify-between gap-2 flex-wrap mb-3">
            <h2 class="m-0 text-lg font-bold">Dolabım <span id="item-count" class="tag"></span></h2>
            <div class="flex gap-1 flex-wrap" id="filters"></div>
          </div>
          <div id="items" class="grid-items"></div>
        </div>
      </div>
    </section>

    <!-- KOMBİN YAP -->
    <section id="tab-studio" class="hidden">
      <div class="grid gap-4 lg:grid-cols-[360px_1fr]">
        <div class="glass p-5 h-fit">
          <h2 class="m-0 text-lg font-bold mb-3">Kombin tuvali</h2>
          <div id="canvas" class="flex flex-col gap-2"></div>
          <div class="flex gap-2 mt-4 flex-wrap">
            <button class="btn" id="save-outfit" type="button"><i data-lucide="heart"></i>Kombini kaydet</button>
            <button class="btn soft" id="clear-outfit" type="button"><i data-lucide="eraser"></i>Temizle</button>
          </div>
          <p id="outfit-msg" class="m-0 mt-2 text-sm hidden" style="color:var(--accent)" role="alert"></p>
        </div>
        <div class="flex flex-col gap-4">
          <div class="glass p-5"><h2 class="m-0 text-lg font-bold mb-2">Dolaptan seç</h2><div id="pickers"></div></div>
          <div class="glass p-5">
            <div class="flex items-center justify-between gap-2 flex-wrap mb-3">
              <h2 class="m-0 text-lg font-bold">Stil danışmanı</h2>
              <button class="btn" id="ask-ai" type="button"><i data-lucide="wand-sparkles"></i>Gemini ile Kombini Analiz Et</button>
            </div>
            <div id="chat" class="flex flex-col gap-2 min-h-[90px] max-h-[360px] overflow-y-auto" aria-live="polite">
              <div class="bub ai">Tuvale parçalar ekle, sonra analiz iste. Renk, kumaş dokusu ve mevsim uyumunu birlikte değerlendiririm.</div>
            </div>
            <form id="chat-form" class="flex gap-2 mt-3"><input id="chat-input" placeholder="Bir şey sor: Bu kombine hangi çantayı yakıştırırım?"><button class="btn" type="submit" aria-label="Gönder"><i data-lucide="send"></i></button></form>
          </div>
          <div class="glass p-5"><h2 class="m-0 text-lg font-bold mb-3">Kayıtlı kombinler</h2><div id="outfits" class="grid-items"></div></div>
        </div>
      </div>
    </section>

    <!-- ALINACAKLAR -->
    <section id="tab-wish" class="hidden">
      <div class="glass p-5 max-w-2xl mx-auto">
        <h2 class="m-0 text-lg font-bold mb-3">Alınacaklar listesi</h2>
        <form id="wish-form" class="flex gap-2 mb-4" novalidate>
          <input id="w-text" placeholder="Örn: Krem rengi keten pantolon">
          <button class="btn" type="submit"><i data-lucide="plus"></i>Ekle</button>
        </form>
        <ul id="wish-list" class="list-none p-0 m-0 flex flex-col gap-2"></ul>
      </div>
    </section>
  </main>
</div>

<script>
/* ===================== AYARLAR ===================== */
const FIREBASE_CONFIG = {
  apiKey: "AIzaSyCn_MW3WE97GyGYw0EW1J3u24iKqtEFnHY",
