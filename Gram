};
const GEMINI_API_KEY = 'YOUR_GEMINI_API_KEY';
const GEMINI_MODEL = 'gemini-2.0-flash';

/* ===================== YARDIMCILAR ===================== */
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
const icons = () => { try { window.lucide && lucide.createIcons(); } catch (e) {} };
const CATS = { sal: { l: 'Şal / Eşarp', e: '🧣' }, ust: { l: 'Üst', e: '👕' }, alt: { l: 'Alt', e: '👖' }, ayakkabi: { l: 'Ayakkabı', e: '👟' } };
const useFirebase = !!(window.firebase && FIREBASE_CONFIG.apiKey && !FIREBASE_CONFIG.apiKey.startsWith('YOUR_'));
const hasGemini = !!GEMINI_API_KEY && !GEMINI_API_KEY.startsWith('YOUR_');
const store = { get: (k, d) => { try { return JSON.parse(localStorage.getItem(k)) ?? d; } catch (e) { return d; } }, set: (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); return true; } catch (e) { return false; } } };
function flash(el, msg, ok) { el.textContent = msg; el.style.color = ok ? '#1a7f37' : 'var(--accent)'; el.classList.remove('hidden'); clearTimeout(el._t); el._t = setTimeout(() => el.classList.add('hidden'), 4000); }

/* ===================== DURUM ===================== */
let user = null, data = { items: [], outfits: [], wish: [] }, look = { sal: null, ust: null, alt: null, ayakkabi: null }, filter = 'hepsi', mode = 'login', auth = null, db = null, shadow = { items: {}, outfits: {}, wish: {} };
const save = () => { if (user && !store.set('grwm_data_' + user.id, data)) alert('Depolama dolu. Bazı parçaları silin veya görsel URL kullanın.'); stats(); cloudSave(); };
/* ===================== BULUT (Firestore) ===================== */
const COLS = ['items', 'outfits', 'wish'];
const ser = x => JSON.stringify(x, (k, v) => v && typeof v === 'object' && !Array.isArray(v) ? Object.fromEntries(Object.entries(v).sort(([a], [b]) => a < b ? -1 : 1)) : v);
const setSync = t => { const el = $('#sync-label'); if (el) { el.textContent = t; el.classList.toggle('hidden', !t); } };
const colRef = c => db.collection('users').doc(user.id).collection(c);
let syncing = Promise.resolve();
function cloudSave() {
  if (!db || !user) return;
  setSync('Eşitleniyor…');
  syncing = syncing.then(async () => {
    const batch = db.batch(); let n = 0;
    for (const c of COLS) {
      const cur = {}; data[c].forEach(x => cur[x.id] = ser(x));
      for (const id in cur) if (shadow[c][id] !== cur[id]) { batch.set(colRef(c).doc(id), JSON.parse(cur[id])); n++; }
      for (const id in shadow[c]) if (!(id in cur)) { batch.delete(colRef(c).doc(id)); n++; }
    }
    if (n) await batch.commit();
    COLS.forEach(c => { shadow[c] = Object.fromEntries(data[c].map(x => [x.id, ser(x)])); });
    setSync('☁ Eşitlendi');
  }).catch(e => { console.warn(e); shadow = { items: {}, outfits: {}, wish: {} }; setSync('Eşitlenemedi, tekrar denenecek'); });
}
async function cloudLoad() {
  setSync('Eşitleniyor…');
  const snaps = await Promise.all(COLS.map(c => colRef(c).get()));
  const cloud = {}; let count = 0;
  COLS.forEach((c, i) => { cloud[c] = snaps[i].docs.map(d => d.data()).sort((a, b) => a.id < b.id ? 1 : -1); count += cloud[c].length; });
  if (!count && COLS.some(c => data[c].length)) { cloudSave(); return; } // ilk giriş: yerel veriyi buluta taşı
  data = cloud; store.set('grwm_data_' + user.id, data);
  COLS.forEach(c => { shadow[c] = Object.fromEntries(data[c].map(x => [x.id, ser(x)])); });
  setSync('☁ Eşitlendi');
}
function stats() { $('#st-items').textContent = data.items.length; $('#st-outfits').textContent = data.outfits.length; $('#st-wish').textContent = data.wish.filter(w => !w.done).length; }

/* ===================== SAYFA YÖNETİMİ (yönlendirme yok) ===================== */
function showAuth() { user = null; $('#main-app').classList.add('hidden'); $('#auth-screen').classList.remove('hidden'); icons(); }
function enter(u) {
  user = u; data = Object.assign({ items: [], outfits: [], wish: [] }, store.get('grwm_data_' + u.id, {}));
  look = { sal: null, ust: null, alt: null, ayakkabi: null };
  $('#auth-screen').classList.add('hidden'); $('#main-app').classList.remove('hidden');
  $('#user-label').textContent = u.email; $('#user-label').classList.remove('hidden');
  switchTab('closet'); renderAll();
  shadow = { items: {}, outfits: {}, wish: {} };
  if (db) cloudLoad().then(renderAll).catch(e => { console.warn(e); setSync('Çevrimdışı: veriler bu cihazda'); });
}
function switchTab(t) {
  ['closet', 'studio', 'wish'].forEach(n => $('#tab-' + n).classList.toggle('hidden', n !== t));
  $$('.tab[data-tab]').forEach(b => b.classList.toggle('on', b.dataset.tab === t));
  if (t === 'studio') renderStudio();
  icons();
}
$$('.tab[data-tab]').forEach(b => b.addEventListener('click', () => switchTab(b.dataset.tab)));

/* ===================== GİRİŞ / KAYIT ===================== */
const hash = s => btoa(unescape(encodeURIComponent('grwm::' + s)));
function setMode(m) {
  mode = m; $('#mode-login').classList.toggle('on', m === 'login'); $('#mode-register').classList.toggle('on', m === 'register');
  $('#auth-submit').textContent = m === 'login' ? 'Giriş Yap' : 'Hesap Oluştur';
  $('#password').autocomplete = m === 'login' ? 'current-password' : 'new-password';
}
$('#mode-login').onclick = () => setMode('login');
$('#mode-register').onclick = () => setMode('register');
$('#auth-note').textContent = useFirebase ? '' : 'Test modu: Firebase ayarı yok, hesaplar yalnızca bu tarayıcıda saklanır.';
$('#auth-form').addEventListener('submit', async e => {
  e.preventDefault();
  const email = $('#email').value.trim().toLowerCase(), pass = $('#password').value, msg = $('#auth-msg');
  if (!/^\S+@\S+\.\S+$/.test(email)) return flash(msg, 'Geçerli bir e-posta adresi gir.');
  if (pass.length < 6) return flash(msg, 'Şifre en az 6 karakter olmalı.');
  try {
    if (useFirebase) {
      if (mode === 'register') await auth.createUserWithEmailAndPassword(email, pass);
      else await auth.signInWithEmailAndPassword(email, pass);
      return; // onAuthStateChanged ekranı değiştirir
    }
    const users = store.get('grwm_users', {});
    if (mode === 'register') {
      if (users[email]) return flash(msg, 'Bu e-posta zaten kayıtlı. Giriş yapmayı dene.');
      users[email] = hash(pass); store.set('grwm_users', users);
    } else if (users[email] !== hash(pass)) return flash(msg, 'E-posta veya şifre hatalı.');
    const u = { id: hash(email).replace(/\W/g, ''), email }; store.set('grwm_session', u); enter(u);
  } catch (err) {
    const map = { 'auth/email-already-in-use': 'Bu e-posta zaten kayıtlı.', 'auth/invalid-credential': 'E-posta veya şifre hatalı.', 'auth/wrong-password': 'E-posta veya şifre hatalı.', 'auth/user-not-found': 'Bu e-postayla hesap yok.', 'auth/weak-password': 'Şifre çok zayıf.' };
    flash(msg, map[err.code] || 'Giriş yapılamadı: ' + (err.message || 'bilinmeyen hata'));
  }
});
$('#logout').onclick = async () => {
  try { if (useFirebase) await auth.signOut(); } catch (e) {}
  localStorage.removeItem('grwm_session'); shadow = { items: {}, outfits: {}, wish: {} }; setSync(''); showAuth();
};

/* ===================== DOLABIM ===================== */
function ph(it) { return `<div class="ph" data-c="${it.cat}">${it.img ? `<img src="${esc(it.img)}" alt="${esc(it.name)}" onerror="this.parentNode.textContent='${CATS[it.cat].e}'">` : CATS[it.cat].e}</div>`; }
function pinterest(it) {
  const q = [it.color, it.fabric, it.name, CATS[it.cat].l.split(' ')[0], 'kombin'].join(' ').toLocaleLowerCase('tr').replace(/\s+/g, ' ').trim();
  window.open('https://www.pinterest.com/search/pins/?q=' + encodeURIComponent(q).replace(/%20/g, '+'), '_blank', 'noopener');
}
function renderFilters() {
  $('#filters').innerHTML = [['hepsi', 'Hepsi'], ...Object.entries(CATS).map(([k, v]) => [k, v.l])]
    .map(([k, l]) => `<button type="button" class="btn sm ${filter === k ? '' : 'soft'}" data-f="${k}">${l}</button>`).join('');
  $$('#filters button').forEach(b => b.onclick = () => { filter = b.dataset.f; renderCloset(); });
}
function renderCloset() {
  renderFilters();
  const list = data.items.filter(i => filter === 'hepsi' || i.cat === filter);
  $('#item-count').textContent = data.items.length;
  $('#items').innerHTML = list.length ? list.map(it => `
    <article class="card">${ph(it)}
      <div class="font-semibold text-sm leading-tight">${esc(it.name)}</div>
      <div class="flex gap-1 flex-wrap"><span class="tag">${CATS[it.cat].l}</span><span class="tag coffee">${esc(it.color)} · ${esc(it.fabric)}</span></div>
      <button class="btn soft sm" data-pin="${it.id}" type="button"><i data-lucide="search"></i>Pinterest'te İlham Bul</button>
      <div class="flex gap-1"><button class="btn soft sm flex-1" data-use="${it.id}" type="button">Kombine ekle</button><button class="btn soft sm" data-del="${it.id}" type="button" aria-label="Sil"><i data-lucide="trash-2"></i></button></div>
    </article>`).join('') : `<p style="color:var(--mute)">${data.items.length ? 'Bu kategoride parça yok.' : 'Dolabın boş. Soldaki formdan ilk parçanı ekle.'}</p>`;
  $$('[data-pin]').forEach(b => b.onclick = () => pinterest(data.items.find(i => i.id === b.dataset.pin)));
  $$('[data-use]').forEach(b => b.onclick = () => { const it = data.items.find(i => i.id === b.dataset.use); look[it.cat] = it.id; switchTab('studio'); });
  $$('[data-del]').forEach(b => b.onclick = () => {
    const id = b.dataset.del; if (!confirm('Bu parça silinsin mi?')) return;
    data.items = data.items.filter(i => i.id !== id); Object.keys(look).forEach(k => { if (look[k] === id) look[k] = null; });
    save(); renderAll();
  });
  icons();
}
function shrink(file) {
  return new Promise((res, rej) => {
    const r = new FileReader();
    r.onerror = () => rej(new Error('Dosya okunamadı'));
    r.onload = () => { const im = new Image(); im.onerror = () => rej(new Error('Görsel açılamadı'));
      im.onload = () => { const s = Math.min(1, 400 / Math.max(im.width, im.height)), c = document.createElement('canvas'); c.width = im.width * s; c.height = im.height * s; c.getContext('2d').drawImage(im, 0, 0, c.width, c.height); res(c.toDataURL('image/jpeg', .72)); };
      im.src = r.result; };
    r.readAsDataURL(file);
  });
}
$('#item-form').addEventListener('submit', async e => {
  e.preventDefault();
  const name = $('#i-name').value.trim(), color = $('#i-color').value.trim(), msg = $('#item-msg');
  if (!name || !color) return flash(msg, 'Parça adı ve renk gerekli.');
  let img = $('#i-url').value.trim();
  const f = $('#i-file').files[0];
  if (f) { try { img = await shrink(f); } catch (err) { return flash(msg, err.message); } }
  data.items.unshift({ id: uid(), name, cat: $('#i-cat').value, color, fabric: $('#i-fabric').value, img });
  save(); e.target.reset(); renderAll(); flash(msg, 'Dolaba eklendi.', true);
});

/* ===================== KOMBİN TUVALİ ===================== */
const byId = id => data.items.find(i => i.id === id);
function renderStudio() {
  $('#canvas').innerHTML = Object.keys(CATS).map(k => {
    const it = look[k] && byId(look[k]);
    return `<div class="slot">${it ? ph(it) : `<div class="ph">${CATS[k].e}</div>`}
      <div class="min-w-0 flex-1"><div class="text-xs" style="color:var(--mute)">${CATS[k].l}</div>
      ${it ? `<div class="font-semibold text-sm truncate">${esc(it.name)}</div><div class="text-xs" style="color:var(--mute)">${esc(it.color)} · ${esc(it.fabric)}</div>
      <div class="flex gap-1 mt-1"><button class="btn soft sm" data-cpin="${it.id}" type="button">Pinterest</button><button class="btn soft sm" data-crm="${k}" type="button">Çıkar</button></div>`
      : '<div class="text-sm" style="color:var(--mute)">Boş katman</div>'}</div></div>`;
  }).join('');
  $$('[data-cpin]').forEach(b => b.onclick = () => pinterest(byId(b.dataset.cpin)));
  $$('[data-crm]').forEach(b => b.onclick = () => { look[b.dataset.crm] = null; renderStudio(); });
  $('#pickers').innerHTML = Object.keys(CATS).map(k => {
    const l = data.items.filter(i => i.cat === k);
    return `<div class="mb-2"><div class="text-sm font-semibold mb-1">${CATS[k].e} ${CATS[k].l}</div><div class="strip">${l.length ? l.map(it => `<button type="button" class="chip ${look[k] === it.id ? 'on' : ''}" data-pk="${k}" data-id="${it.id}">${ph(it)}<div class="truncate mt-1">${esc(it.name)}</div></button>`).join('') : '<span class="text-sm" style="color:var(--mute)">Bu kategoride parça yok.</span>'}</div></div>`;
  }).join('');
  $$('[data-pk]').forEach(b => b.onclick = () => { const k = b.dataset.pk; look[k] = look[k] === b.dataset.id ? null : b.dataset.id; renderStudio(); });
  renderOutfits(); icons();
}
function renderOutfits() {
  $('#outfits').innerHTML = data.outfits.length ? data.outfits.map(o => `
    <article class="card"><div class="grid grid-cols-2 gap-1">${Object.keys(CATS).map(k => { const it = o.parts[k] && byId(o.parts[k]); return it ? ph(it).replace('class="ph"', 'class="ph" style="font-size:20px"') : `<div class="ph" style="opacity:.35;font-size:20px">${CATS[k].e}</div>`; }).join('')}</div>
      <div class="font-semibold text-sm">${esc(o.name)}</div>
      <div class="flex gap-1"><button class="btn soft sm flex-1" data-load="${o.id}" type="button">Tuvale al</button><button class="btn soft sm" data-odel="${o.id}" type="button" aria-label="Sil"><i data-lucide="trash-2"></i></button></div></article>`).join('')
    : '<p style="color:var(--mute)">Henüz kayıtlı kombin yok.</p>';
  $$('[data-load]').forEach(b => b.onclick = () => { const o = data.outfits.find(x => x.id === b.dataset.load); look = Object.assign({ sal: null, ust: null, alt: null, ayakkabi: null }, o.parts); renderStudio(); });
  $$('[data-odel]').forEach(b => b.onclick = () => { data.outfits = data.outfits.filter(x => x.id !== b.dataset.odel); save(); renderOutfits(); icons(); });
}
$('#save-outfit').onclick = () => {
  const parts = Object.fromEntries(Object.entries(look).filter(([, v]) => v && byId(v)));
  if (!Object.keys(parts).length) return flash($('#outfit-msg'), 'Önce tuvale en az bir parça ekle.');
  const name = prompt('Kombine bir isim ver:', 'Kombin ' + (data.outfits.length + 1));
  if (name === null) return;
  data.outfits.unshift({ id: uid(), name: name.trim() || 'Kombin ' + (data.outfits.length + 1), parts });
  save(); renderOutfits(); icons(); flash($('#outfit-msg'), 'Kombin kaydedildi.', true);
};
$('#clear-outfit').onclick = () => { look = { sal: null, ust: null, alt: null, ayakkabi: null }; renderStudio(); };

/* ===================== GEMİNİ STİL DANIŞMANI ===================== */
const chat = $('#chat');
function bubble(t, who) { const d = document.createElement('div'); d.className = 'bub ' + who; d.textContent = t; chat.appendChild(d); chat.scrollTop = chat.scrollHeight; return d; }
function lookText() {
  const l = Object.keys(CATS).map(k => { const it = look[k] && byId(look[k]); return it ? `- ${CATS[k].l}: ${it.name} (renk: ${it.color}, kumaş: ${it.fabric})` : null; }).filter(Boolean);
  return l.length ? l.join('\n') : '';
}
function offlineTip() {
  const fabs = Object.values(look).map(id => id && byId(id)).filter(Boolean).map(i => i.fabric);
  const light = fabs.filter(f => ['Şifon', 'İpek', 'Saten', 'Keten', 'Pamuk'].includes(f)).length, heavy = fabs.filter(f => ['Yün', 'Triko', 'Kadife', 'Deri', 'Kot'].includes(f)).length;
  return 'Gemini API anahtarı tanımlı olmadığı için basit bir yerel değerlendirme gösteriyorum.\n' +
    (new Set(fabs).size < fabs.length ? 'Aynı kumaştan birden fazla parça var; doku tekrarı sakin ama düz görünebilir. Bir parçayı farklı dokuyla dengele.' : 'Kumaşlar birbirinden farklı; doku çeşitliliği kombine derinlik katar.') +
    (light && !heavy ? '\nParçalar hafif kumaşlardan oluşuyor: ilkbahar ve yaz için uygun.' : heavy && !light ? '\nParçalar kalın dokulu: sonbahar ve kış için uygun.' : light && heavy ? '\nHafif ve kalın kumaşlar karışık: ara mevsim için dengeli.' : '') +
    '\nDaha ayrıntılı analiz için dosyadaki GEMINI_API_KEY alanını doldur.';
}
async function gemini(prompt) {
  const r = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${encodeURIComponent(GEMINI_API_KEY)}`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ contents: [{ role: 'user', parts: [{ text: prompt }] }] })
  });
  const j = await r.json();
  if (!r.ok) throw new Error(j.error?.message || 'API hatası (' + r.status + ')');
  return j.candidates?.[0]?.content?.parts?.map(p => p.text).join('') || 'Yanıt alınamadı, tekrar dene.';
}
async function ask(userMsg, extra) {
  const lt = lookText();
  if (!lt) return bubble('Önce tuvale en az bir parça ekle.', 'ai');
  bubble(userMsg, 'me');
  if (!hasGemini) return bubble(offlineTip(), 'ai');
  const wait = bubble('Düşünüyorum…', 'ai');
  const prompt = 'Sen Türkçe konuşan, samimi ve zarif bir stil danışmanısın. Kullanıcının kombini:\n' + lt +
    '\n\n' + extra + '\nRenk uyumunu, kumaş dokularının birlikte nasıl durduğunu (ör. keten üst ile şifon şal) ve mevsim uygunluğunu değerlendir. Kısa, net ve uygulanabilir yaz (en fazla 150 kelime).';
  try { wait.textContent = await gemini(prompt); } catch (e) { wait.textContent = 'Stil önerisi alınamadı: ' + e.message + '\nAnahtarı ve internet bağlantını kontrol et.'; }
  chat.scrollTop = chat.scrollHeight;
}
$('#ask-ai').onclick = () => ask('Bu kombini analiz eder misin?', 'Kombini genel olarak analiz et ve bir iyileştirme öner.');
$('#chat-form').addEventListener('submit', e => { e.preventDefault(); const q = $('#chat-input').value.trim(); if (!q) return; $('#chat-input').value = ''; ask(q, 'Kullanıcının sorusu: ' + q); });

/* ===================== ALINACAKLAR ===================== */
function renderWish() {
  $('#wish-list').innerHTML = data.wish.length ? data.wish.map(w => `
    <li class="wish-i">
      <input type="checkbox" style="width:20px;height:20px;accent-color:var(--accent)" data-wc="${w.id}" ${w.done ? 'checked' : ''} aria-label="Tamamlandı">
      <span class="flex-1 ${w.done ? 'done' : ''}">${esc(w.text)}</span>
      <button class="btn soft sm" data-wdel="${w.id}" type="button" aria-label="Sil"><i data-lucide="trash-2"></i></button></li>`).join('')
    : '<li style="color:var(--mute)">Listen boş. Gardıroba eksik olan parçaları buraya ekle.</li>';
  $$('[data-wc]').forEach(c => c.onchange = () => { data.wish.find(w => w.id === c.dataset.wc).done = c.checked; save(); renderWish(); });
  $$('[data-wdel]').forEach(b => b.onclick = () => { data.wish = data.wish.filter(w => w.id !== b.dataset.wdel); save(); renderWish(); });
  icons();
}
$('#wish-form').addEventListener('submit', e => {
  e.preventDefault(); const t = $('#w-text').value.trim(); if (!t) return;
  data.wish.unshift({ id: uid(), text: t, done: false }); $('#w-text').value = ''; save(); renderWish();
});

/* ===================== BAŞLAT ===================== */
function renderAll() { renderCloset(); renderStudio(); renderWish(); stats(); }
$('#hero-cta').onclick = () => switchTab('studio');
(function init() {
  try {
    if (useFirebase) {
      firebase.initializeApp(FIREBASE_CONFIG); auth = firebase.auth(); if (firebase.firestore) db = firebase.firestore();
      auth.onAuthStateChanged(u => u ? enter({ id: u.uid, email: u.email || 'kullanıcı' }) : showAuth());
      return;
    }
  } catch (e) { console.warn('Firebase başlatılamadı, test moduna geçildi:', e); }
  const s = store.get('grwm_session', null);
  s && s.id && s.email ? enter(s) : showAuth();
})();
</script>
